# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Local Netlify folder
.netlify

# iCloud Drive conflict-copy directories (this project sits on an iCloud-synced
